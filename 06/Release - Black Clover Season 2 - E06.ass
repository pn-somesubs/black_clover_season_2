Dialogue: 0,0:00:00.00,0:00:10.00,main,,0,0,0,,{\fs20\an7\fe162\fad(400,400)\bord2\blur5\4a&HFF&\fnSweetest Cat Ever}\N{\pos(20,-2)\c&HFFFF00&\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} ibrahimhilmiykr\N{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Velnoxy\N{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} Mitos\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 9,0:00:02.31,0:00:04.65,main,ASTA,0,0,0,,Magna!
Dialogue: 9,0:00:05.09,0:00:06.56,main,MAGNA,0,0,0,,Asta... Luck...
Dialogue: 9,0:00:11.71,0:00:13.30,main,ASTA,0,0,0,,Kaptan Yami ve ben bu herife
Dialogue: 9,0:00:13.30,0:00:16.28,main,ASTA,0,0,0,,Bir çizik atmak için neler \Nçektik.
Dialogue: 9,0:00:16.81,0:00:19.79,main,ASTA,0,0,0,,Harikasın Magna!
Dialogue: 9,0:00:21.32,0:00:22.62,main,MAGNA,0,0,0,,Tabi lan.
Dialogue: 9,0:00:22.62,0:00:24.47,main,MAGNA,0,0,0,,Abilerini hafife alma.
Dialogue: 9,0:00:24.47,0:00:27.15,main,ASTA,0,0,0,,Harikasın! Adam gibi adam be!
Dialogue: 9,0:00:27.73,0:00:28.75,main,LUCK,0,0,0,,Magna.
Dialogue: 9,0:00:30.12,0:00:33.51,main,LUCK,0,0,0,,Bir gün seninle dövüşmek için\N can atıyorum.
Dialogue: 9,0:00:35.01,0:00:37.76,main,MAGNA,0,0,0,,Kıçına tekmeyi basacağım Luck.
Dialogue: 9,0:00:40.26,0:00:42.29,italics,JACK (INT),0,0,0,,Ben sıradan biriyim.
Dialogue: 9,0:00:42.72,0:00:46.01,italics,JACK (INT),0,0,0,,Buna rağmen kendi emeğimle\Nkaptan oldum.
Dialogue: 9,0:00:46.01,0:00:49.02,italics,JACK (INT),0,0,0,,Soyluymuş, Asilmiş, beni \Ngeçmelerine izin veremem.
Dialogue: 9,0:00:49.29,0:00:52.57,italics,JACK (INT),0,0,0,,Ekibime sürekli köylüleri alıyorum.
Dialogue: 9,0:00:52.57,0:00:59.03,italics,JACK (INT),0,0,0,,Ama Yami takımına köylüleri almaya başladığında\Naklını kaçırdığını düşünmüştüm.
Dialogue: 9,0:00:59.35,0:01:00.77,italics,JACK (INT),0,0,0,,Kahretsin.
Dialogue: 9,0:01:01.85,0:01:04.54,main,JACK,0,0,0,,Bana bayağı ilginç şeyler gösterdin.
Dialogue: 9,0:01:05.45,0:01:11.35,italics,NACHT (INT),0,0,0,,%100 Şeytan gücü kullanan Karanlık\NÜçlü üst düzey şeytanlarla denk olmalı.
Dialogue: 9,0:01:12.45,0:01:14.21,italics,NACHT (INT),0,0,0,,ve buna rağmen o...
Dialogue: 9,0:01:15.00,0:01:18.46,italics,NACHT (INT),0,0,0,,Nasıl yaptı bilmiyorum fakat \Niyi iş çıkardı.
Dialogue: 9,0:01:20.17,0:01:21.76,italics,NACHT (INT),0,0,0,,Her neyse, artık...
Dialogue: 9,0:01:29.35,0:01:31.82,main,MORRIS,0,0,0,,Şeytanlar durmak bilmiyor.
Dialogue: 9,0:01:32.73,0:01:34.62,main,MORRIS,0,0,0,,Harika bir manzara.
Dialogue: 9,0:01:48.04,0:01:49.77,main,MORRIS,0,0,0,,Sanırım Dante kaybetti.
Dialogue: 9,0:01:50.72,0:01:54.42,main,MORRIS,0,0,0,,Acaba nasıl bir büyü \Nonu yenebilmiştir.
Dialogue: 9,0:01:54.91,0:01:56.93,main,NACHT,0,0,0,,Üçlünün biri yenildiğine göre.
Dialogue: 9,0:01:56.93,0:01:59.43,main,NACHT,0,0,0,,Qliphoth'un işleyişi biraz yavaşlamış olmalı
Dialogue: 9,0:01:59.70,0:02:01.93,main,NACHT,0,0,0,,ama diğer ikisini yenmediğimiz sürece
Dialogue: 9,0:02:01.93,0:02:04.77,main,NACHT,0,0,0,,Qliphoth'u tamamen durdurmamız imkansız.
Dialogue: 9,0:02:05.82,0:02:08.94,main,NACHT,0,0,0,,Çok kalmadı, ve büyük ihtimalle yetmeyecektir
Dialogue: 9,0:02:08.94,0:02:11.00,main,NACHT,0,0,0,,ama yanımda biraz büyülü \Natıştırmalık kaldı.
Dialogue: 9,0:02:11.00,0:02:11.98,main,NACHT,0,0,0,,Ye.
Dialogue: 9,0:02:11.98,0:02:15.60,main,MAGNA,0,0,0,,Budur be! Bu gidişle Bay Yami'yi kurtarırım!
Dialogue: 9,0:02:15.60,0:02:16.69,main,ASTA,0,0,0,,Hayır! Ben!
Dialogue: 9,0:02:16.69,0:02:18.11,main,LUCK,0,0,0,,Hayır ben!
Dialogue: 9,0:02:18.34,0:02:21.12,main,NACHT,0,0,0,,Diğer Karanlık Üçlü üyelerinin büyü \Netkileri aşırı yüksek.
Dialogue: 9,0:02:21.12,0:02:23.37,main,NACHT,0,0,0,,Yani bizleri gölgelerden \Nyürütemem, hadi gidelim.
Dialogue: 9,0:02:23.37,0:02:24.76,main,MAGNA,0,0,0,,Tamamdır!
Dialogue: 9,0:02:43.45,0:02:47.14,main,DANTE,0,0,0,,Böyle birine kaybetmiş olamam.
Dialogue: 9,0:02:47.14,0:02:49.34,main,DANTE,0,0,0,,BU İMKANSIZ!
Dialogue: 9,0:02:49.34,0:02:52.86,main,JACK,0,0,0,,Vay be. Karanlık Üçlü harbiciymiş.
Dialogue: 9,0:02:53.79,0:02:57.25,main,JACK,0,0,0,,İyileştirme yeteneğin cidden hızlı.
Dialogue: 9,0:02:59.04,0:03:03.78,main,JACK,0,0,0,,Fakat vücut büyünün kontrolünü kaybettiğin\Niçin mala bağlıyorsun.
Dialogue: 9,0:03:03.78,0:03:05.67,main,DANTE,0,0,0,,KES LAN!
Dialogue: 9,0:03:05.67,0:03:07.40,main,DANTE,0,0,0,,BEN ÖLÜMSÜZÜM!
Dialogue: 9,0:03:07.40,0:03:10.29,main,DANTE,0,0,0,,ÖNCE SENİ SONRA HEPİNİZİ ÖLDÜRECEĞİM!
Dialogue: 9,0:03:10.65,0:03:14.79,main,DANTE,0,0,0,,KAYBETMİŞ OLAMAM!
Dialogue: 9,0:03:11.89,0:03:14.79,main,JACK,0,0,0,,Bi sus artık be.
Dialogue: 9,0:03:15.54,0:03:18.55,main,JACK,0,0,0,,İnatçıları sevmediğimi söyleyemem ama...
Dialogue: 9,0:03:18.85,0:03:21.92,main,DANTE,0,0,0,,O herif kazandı ve sevincini\Nbölmesen iyi olur!
Dialogue: 0,0:03:24.24,0:03:27.93,Ep Title,EP TITLE,0,0,0,,{\c&H0B00E8&\pos(321.33,95)}Kutsal Valkür
Dialogue: 9,0:03:38.57,0:03:40.93,italics,CHARLOTTE (INT),0,0,0,,Mavi güllerim onun lanet korumasını\Nlimitlese bile
Dialogue: 9,0:03:40.93,0:03:43.16,italics,CHARLOTTE (INT),0,0,0,,kan büyüsü başlı başına yetiyor
Dialogue: 9,0:03:43.16,0:03:44.37,italics,CHARLOTTE (INT),0,0,0,,Ve...
Dialogue: 9,0:03:44.73,0:03:48.37,main,VANICA,0,0,0,,Takım çalışmamız işe yarıyor!
Dialogue: 9,0:03:49.17,0:03:51.56,main,VANICA,0,0,0,,Di'mi Loropechika?
Dialogue: 9,0:03:52.08,0:03:54.86,main,VANICA,0,0,0,,Eğer tüm gücünü kullanırsan\Nsaldırılarının
Dialogue: 9,0:03:54.86,0:03:57.17,main,VANICA,0,0,0,,Çok daha güçlü olacağını biliyorum tatlım!
Dialogue: 9,0:03:57.67,0:04:01.30,main,VANICA,0,0,0,,Tümünü vermek çok iyi \Nhissettiriyor, haksız mıyım?
Dialogue: 9,0:04:01.57,0:04:02.74,main,RILL,0,0,0,,Loropechika!
Dialogue: 9,0:04:02.74,0:04:05.34,italics,RILL (INT),0,0,0,,Görüntü Büyüsü: Yeraltı Devi.
Dialogue: 9,0:04:06.55,0:04:09.39,main,VANICA,0,0,0,,Git ve bitir işini, sevgili Loropechika.
Dialogue: 9,0:04:23.13,0:04:28.28,italics,RILL (INT),0,0,0,,Zaten fazlasıyla güçlüydü, şimdi \Nlanet yüzünden daha da güçlü.
Dialogue: 9,0:04:30.77,0:04:32.45,italics,CHARLOTTE (INT),0,0,0,,Kraliçe Loropechika.
Dialogue: 9,0:04:32.73,0:04:36.64,italics,CHARLOTTE (INT),0,0,0,,Bedeninizin çalınmasının ne kadar \Nacı verici ve yorucu olduğunu biliyorum!
Dialogue: 9,0:04:37.45,0:04:40.55,main,CHARLOTTE,0,0,0,,Yemin ederimki o laneti kıracağım!
Dialogue: 9,0:04:46.14,0:04:49.71,main,VANICA,0,0,0,,Niye savaşın tadını çıkarmıyorsunuz?
Dialogue: 9,0:04:49.71,0:04:53.23,main,VANICA,0,0,0,,İşte tam bu yüzden öleceksiniz!
Dialogue: 9,0:04:53.23,0:04:54.64,main,RILL,0,0,0,,Charlotte!
Dialogue: 9,0:05:03.49,0:05:05.40,main,NOELLE,0,0,0,,Söz verdiğim gibi burdayım.
Dialogue: 9,0:05:05.40,0:05:06.45,main,NOELLE,0,0,0,,Vanica!
Dialogue: 9,0:05:07.70,0:05:09.20,main,GAJA,0,0,0,,Kraliçe Loropechika!
Dialogue: 9,0:05:09.45,0:05:13.41,main,VANICA,0,0,0,,Sana söylediğim gibi güçlendin mi?
Dialogue: 9,0:05:13.41,0:05:18.10,main,VANICA,0,0,0,,Ben daha da güçlendim. \NBana ayak uydurabilecek misin?
Dialogue: 9,0:05:19.84,0:05:21.76,main,NOELLE,0,0,0,,Ne cürettle Loropechika'ya.
Dialogue: 9,0:05:22.34,0:05:24.17,main,NOELLE,0,0,0,,Endişelenme Vanica.
Dialogue: 9,0:05:24.77,0:05:25.97,main,NOELLE,0,0,0,,Ben...
Dialogue: 9,0:05:27.60,0:05:30.93,main,NOELLE,0,0,0,,Hayır, biz{\i0} kesinlikle seni yeneceğiz!
Dialogue: 9,0:05:32.09,0:05:33.52,main,VANICA,0,0,0,,Biliyordum!
Dialogue: 9,0:05:35.52,0:05:39.00,main,CHARLOTTE,0,0,0,,Kraliçe Loropechika'ya hizmet eden\N Undine neden.
Dialogue: 9,0:05:39.73,0:05:41.23,flashback,DRYAD (FB),0,0,0,,Noelle...
Dialogue: 9,0:05:42.55,0:05:45.60,flashback,DRYAD (FB),0,0,0,,Mutlak büyülerden falan önce,
Dialogue: 9,0:05:45.60,0:05:48.22,flashback,DRYAD (FB),0,0,0,,elde etmen gereken belirli bir güç var.
Dialogue: 9,0:05:48.54,0:05:49.83,flashback,NOELLE (FB),0,0,0,,Ne?
Dialogue: 9,0:05:51.66,0:05:53.29,flashback,DRYAD (FB),0,0,0,,Yanlış mıyım?
Dialogue: 9,0:05:57.40,0:05:58.71,flashback,NOELLE (FB),0,0,0,,Undine?!
Dialogue: 9,0:05:58.71,0:06:01.46,flashback,NOELLE (FB),0,0,0,,İyisin demek ama nasıl?
Dialogue: 9,0:06:03.94,0:06:06.90,flashback,UNDINE (FB),0,0,0,,Lanet kırmanın gücü büyümün\Nbir kısmını aldı,
Dialogue: 9,0:06:06.90,0:06:10.47,flashback,UNDINE (FB),0,0,0,,ve Loropechika ile olan anlaşmam bir \Nanlığına yok oldu.
Dialogue: 9,0:06:11.05,0:06:15.26,flashback,UNDINE (FB),0,0,0,,Manamı ve gücümü tekrar eskisine çevirmek için
Dialogue: 9,0:06:15.26,0:06:18.14,flashback,UNDINE (FB),0,0,0,,Başka güçlü bir büyücünün kitabına\Nkendimi aktardım.
Dialogue: 9,0:06:18.80,0:06:21.01,flashback,UNDINE (FB),0,0,0,,Noelle, sensin...
Dialogue: 9,0:06:21.87,0:06:24.97,flashback,UNDINE (FB),0,0,0,,Büyü ruhu için gerekenlere sahipsin.
Dialogue: 9,0:06:25.53,0:06:30.78,flashback,DRYAD (FB),0,0,0,,Vücudunun yarısının kullanarak\N Üst düzey şeytan Megiculayı çağırabilen Vanica.
Dialogue: 9,0:06:31.04,0:06:35.54,flashback,DRYAD (FB),0,0,0,,Gizli büyüler kullanmadan da onu \Nindirmenin bi yolu var.
Dialogue: 9,0:06:35.87,0:06:39.23,flashback,DRYAD (FB),0,0,0,,Sadece ruh sahiplerinin girebildiği bir yer.
Dialogue: 9,0:06:39.23,0:06:42.65,flashback,DRYAD (FB),0,0,0,,O ki kötü niyeti saflaştıran\N ve şeytanları yok eden:
Dialogue: 9,0:06:42.65,0:06:44.04,flashback,DRYAD (FB),0,0,0,,Azizler Sahnesi.
Dialogue: 9,0:06:44.67,0:06:46.52,flashback,DRYAD (FB),0,0,0,,Değil mi Undine?
Dialogue: 9,0:06:48.31,0:06:49.68,flashback,NOELLE (FB),0,0,0,,Eğer bu doğruysa,
Dialogue: 9,0:06:49.68,0:06:52.14,flashback,NOELLE (FB),0,0,0,,Niye Kaptan Fuegoleon ve Yuno gibi
Dialogue: 9,0:06:52.14,0:06:54.58,flashback,NOELLE (FB),0,0,0,,başka ruh sahiplerinide Asta ve diğer
Dialogue: 9,0:06:54.58,0:06:56.41,flashback,NOELLE (FB),0,0,0,,Gizemli büyülere bel bağlamamak adına
Dialogue: 9,0:06:56.79,0:06:59.76,flashback,NOELLE (FB),0,0,0,,Buraya almadın? Loropechika'nın \Nbüyüsü de çok güçlü,
Dialogue: 9,0:06:59.76,0:07:02.37,flashback,NOELLE (FB),0,0,0,,Onu da Azizler sahnesinde dövüştürmen\Ngerekmez miydi?
Dialogue: 9,0:07:04.17,0:07:05.80,flashback,UNDINE (FB),0,0,0,,Uzun zaman önce,
Dialogue: 9,0:07:07.05,0:07:10.44,flashback,UNDINE (FB),0,0,0,,Kalp Krallığı'nın ilk kraliçeleriyle\Niyi anlaşır oldum
Dialogue: 9,0:07:10.44,0:07:11.92,flashback,UNDINE (FB),0,0,0,,ve onu benim taşıyıcım yaptım.
Dialogue: 9,0:07:12.79,0:07:16.16,flashback,UNDINE (FB),0,0,0,,O gün bu gündür, Kalp Krallığının \Ninsanlarına resmen aşığım.
Dialogue: 9,0:07:16.16,0:07:18.54,flashback,UNDINE (FB),0,0,0,,Onlarla beraber krallığı korudum.
Dialogue: 9,0:07:19.17,0:07:23.77,flashback,UNDINE (FB),0,0,0,,Yıllar sonra Loropechika ve ben \Ntanıştık.
Dialogue: 9,0:07:25.58,0:07:29.13,flashback,UNDINE (FB),0,0,0,,Küçüklüğünden beri devasa miktarda\Nbüyüsü vardı.
Dialogue: 9,0:07:29.13,0:07:33.05,flashback,UNDINE (FB),0,0,0,,Bir sonraki kraliçe olabilmek için\Nyeterliden de fazlasıydı.
Dialogue: 9,0:07:34.00,0:07:37.91,flashback,UNDINE (FB),0,0,0,,Her şey bir yana, diğer kraliçelerden \Nçok farklıydı.
Dialogue: 9,0:07:38.84,0:07:43.40,flashback,UNDINE (FB),0,0,0,,Loropechika bir saldırı büyüsünü\Nöğrenmekten mahrumdu.
Dialogue: 9,0:07:44.17,0:07:47.18,flashback,UNDINE (FB),0,0,0,,Yapabildiği tek şey saldırı gibi görünen\Nbüyüler yapmaktı
Dialogue: 9,0:07:47.18,0:07:48.78,flashback,UNDINE (FB),0,0,0,,Şovalye hayaletleri vesaire.
Dialogue: 9,0:07:49.19,0:07:53.16,flashback,UNDINE (FB),0,0,0,,Bu da hiçbir zaman Azizler Sahnesi’ne katılamaması ve şeytanları yok edememesi demekti.
Dialogue: 9,0:07:54.17,0:07:57.10,flashback,UNDINE (FB),0,0,0,,O kız bunun için çok nazik.
Dialogue: 9,0:08:00.91,0:08:03.79,flashback,LOROPECHIKA (FB/FB),0,0,0,,Hiç saldırı büyüsü  kullanamıyorum.
Dialogue: 9,0:08:04.06,0:08:06.17,flashback,LOROPECHIKA (FB/FB),0,0,0,,Sanırım kraliçe olmaya uygun değilim.
Dialogue: 9,0:08:08.38,0:08:10.83,flashback,UNDINE (FB/FB),0,0,0,,Bu doğru değil Loropechika.
Dialogue: 9,0:08:11.80,0:08:15.30,flashback,UNDINE (FB/FB),0,0,0,,Senin nezaketin benim onurum!
Dialogue: 9,0:08:16.10,0:08:18.40,flashback,LOROPECHIKA (FB/FB),0,0,0,,Gerçekden mi Undine.
Dialogue: 9,0:08:19.73,0:08:22.59,flashback,UNDINE (FB),0,0,0,,Azizler Sahnesi hakkında tek bir\N söz etmeyeceğim.
Dialogue: 9,0:08:23.15,0:08:24.98,flashback,UNDINE (FB),0,0,0,,Bencillik ettiğimin farkındayım.
Dialogue: 9,0:08:27.09,0:08:30.07,flashback,UNDINE (FB),0,0,0,,Maça krallığında şeytan taşıyıcıları\Nortaya çıktığında bile...
Dialogue: 9,0:08:30.07,0:08:32.96,flashback,UNDINE (FB),0,0,0,,Vanica Loropechikanın peşinden gittiğinde bile...
Dialogue: 9,0:08:33.67,0:08:37.88,flashback,UNDINE (FB),0,0,0,,Loropechika'yı savaşmakdan uzak \Ntutmak istiyordum.
Dialogue: 9,0:08:39.44,0:08:42.81,flashback,UNDINE (FB),0,0,0,,Böyle nazik kalmasını istiyordum.
Dialogue: 9,0:08:45.05,0:08:46.17,flashback,DRYAD (FB),0,0,0,,Undine...
Dialogue: 9,0:08:48.29,0:08:52.68,flashback,UNDINE (FB),0,0,0,,Sonunda, Loropechika lanetlenip kaçırılmıştı.
Dialogue: 9,0:08:54.25,0:08:57.18,flashback,UNDINE (FB),0,0,0,,Hatalıydım.
Dialogue: 9,0:08:58.73,0:08:59.93,flashback,NOELLE (FB),0,0,0,,Evet.
Dialogue: 9,0:09:00.65,0:09:06.06,flashback,NOELLE (FB),0,0,0,,Ona Azizler sahnesinden bahsetmemiş \Nolman büyük hata.
Dialogue: 9,0:09:06.06,0:09:09.08,flashback,NOELLE (FB),0,0,0,,Ama niyetin iyiydi değil mi?
Dialogue: 9,0:09:10.31,0:09:13.45,flashback,NOELLE (FB),0,0,0,,Kibar olmak, birine yakınlık hissetmek,
Dialogue: 9,0:09:13.45,0:09:16.27,flashback,NOELLE (FB),0,0,0,,Bunlar nasıl hata olabilir?!
Dialogue: 9,0:09:16.82,0:09:17.82,flashback,UNDINE (FB),0,0,0,,Noelle.
Dialogue: 9,0:09:18.20,0:09:23.45,flashback,NOELLE (FB),0,0,0,,Pek iyi anlaşmıyoruz fakat amacımız aynı,\Ndeğil mi?
Dialogue: 9,0:09:25.80,0:09:30.31,flashback,NOELLE (FB),0,0,0,,Vanicayı yenmek ve Loropechikayı kurtarmak\Niçin bana katılmanı istiyorum.
Dialogue: 9,0:09:34.67,0:09:39.07,main,VANICA,0,0,0,,Ben ona sadece nasıl iyi hissedeceğini\Nöğretiyordum.
Dialogue: 9,0:09:39.07,0:09:43.60,main,VANICA,0,0,0,,Eminim ki Loropechika şu an çok eğleniyordur!
Dialogue: 9,0:09:43.91,0:09:46.23,main,VANICA,0,0,0,,Değil mi? Loropechika?
Dialogue: 9,0:09:47.28,0:09:50.65,main,VANICA,0,0,0,,Hadi, sen de saldır!
Dialogue: 9,0:09:50.65,0:09:53.78,main,VANICA,0,0,0,,Hepimiz iyi hissedelim!
Dialogue: 9,0:09:53.78,0:09:55.82,main,VANICA,0,0,0,,Bu harika değil mi?
Dialogue: 9,0:09:59.12,0:10:00.97,main,NOELLE,0,0,0,,Yeter.
Dialogue: 9,0:10:01.53,0:10:05.41,main,VANICA,0,0,0,,Hadi Noelle, biraz eğlenelim!
Dialogue: 9,0:10:06.09,0:10:07.62,main,NOELLE,0,0,0,,Biliyor musun?
Dialogue: 9,0:10:08.17,0:10:09.60,main,NOELLE,0,0,0,,Bunlar tamamen,
Dialogue: 9,0:10:11.77,0:10:13.50,main,NOELLE,0,0,0,,Senin suçun!
Dialogue: 9,0:10:15.51,0:10:18.76,main,VANICA,0,0,0,,Bunu bi çırpıda bitirmesen iyi olur!
Dialogue: 9,0:10:19.17,0:10:23.21,main,VANICA,0,0,0,,Beni eğlendirmeye devam et!
Dialogue: 9,0:10:23.21,0:10:25.46,main,NOELLE,0,0,0,,Suscan mı artık?
Dialogue: 9,0:10:27.25,0:10:31.10,main,NOELLE,0,0,0,,Senin gibi tipler ne isterse yapıyorken üstüne mal gibi gülerken
Dialogue: 9,0:10:31.10,0:10:34.23,main,NOELLE,0,0,0,, Masum insanların acı çekmesi.
Dialogue: 9,0:10:37.53,0:10:40.01,main,NOELLE,0,0,0,,Aklım almıyor!
Dialogue: 9,0:10:52.05,0:10:53.29,italics,NOELLE,0,0,0,,Ruh Dalışı...
Dialogue: 9,0:11:00.57,0:11:02.64,italics,NOELLE,0,0,0,,Aziz Valkür Zırhı!
Dialogue: 9,0:11:03.93,0:11:06.83,main,NOELLE,0,0,0,,Seni yok edeceğim!
Dialogue: 9,0:11:12.81,0:11:14.44,italics,VANICA (INT),0,0,0,,Bu his.
Dialogue: 9,0:11:14.73,0:11:18.24,italics,VANICA (INT),0,0,0,,Kan Büyüsü: Kızıl Canavar Sürüsü!
Dialogue: 9,0:11:25.89,0:11:28.70,italics,VANICA (INT),0,0,0,,Kırmızı canavarlar yok oldu.
Dialogue: 9,0:11:29.11,0:11:30.71,italics,VANICA (INT),0,0,0,,Hem gücü hem görünüşü
Dialogue: 9,0:11:30.71,0:11:33.57,italics,VANICA (INT),0,0,0,,Kalp Krallığındaki halinden eser yok!
Dialogue: 9,0:11:36.80,0:11:38.21,italics,VANICA (INT),0,0,0,,Fevkalade...
Dialogue: 9,0:11:38.21,0:11:40.72,main,VANICA,0,0,0,,İşte bunu bekliyordum.
Dialogue: 9,0:11:41.88,0:11:46.10,main,RILL,0,0,0,,Charlotte'nin, mavi gülleri lanet korumasını\Nzayıflatsa bile...
Dialogue: 9,0:11:46.10,0:11:47.68,main,RILL,0,0,0,,Noelle Harika!
Dialogue: 9,0:11:47.68,0:11:49.89,main,UNDINE,0,0,0,,Yine de zamanımız kısıtlı.
Dialogue: 9,0:11:49.89,0:11:52.23,main,UNDINE,0,0,0,,Noelle, onu yenmek için bir dakikan var.
Dialogue: 9,0:11:52.46,0:11:55.25,main,NOELLE,0,0,0,,Gerek yok! Otuz saniye yeter!
Dialogue: 9,0:12:10.75,0:12:16.79,main,VANICA,0,0,0,,Güzel! Çok Güzel! Bu en iyisi, Noelle!
Dialogue: 9,0:12:17.22,0:12:17.88,italics,VANICA (INT),0,0,0,,Oh...
Dialogue: 9,0:12:18.62,0:12:21.38,italics,VANICA (INT),0,0,0,,Bu geçenki gibi bir ürperti...
Dialogue: 9,0:12:21.94,0:12:25.46,italics,VANICA (INT),0,0,0,,Megicula'nın sahibi olduktan\Nhemen sonraki gibi.
Dialogue: 9,0:12:25.46,0:12:29.14,italics,VANICA (INT),0,0,0,,Şeytanın güçlerini sonuna kadar\Ndenemek istemiştim.
Dialogue: 9,0:12:29.41,0:12:32.21,italics,VANICA (INT),0,0,0,,Duydum ki eskiden en güçlü olduğu söylenen kadın
Dialogue: 9,0:12:32.21,0:12:34.64,italics,VANICA (INT),0,0,0,,Saklanıp dinleniyormuş
Dialogue: 9,0:12:34.64,0:12:38.40,italics,VANICA (INT),0,0,0,,bende Maça Krallığından kaçıp onunla \Noynamaya gittim
Dialogue: 9,0:12:38.80,0:12:42.03,flashback,VANICA (FB),0,0,0,,Senin de şeytanının da güçleri çok iyi!
Dialogue: 9,0:12:42.32,0:12:44.28,flashback,VANICA (FB),0,0,0,,Beni eğlendirmeye devam et...
Dialogue: 9,0:12:44.85,0:12:46.26,flashback,VANICA (FB),0,0,0,,Acier!
Dialogue: 9,0:12:47.99,0:12:49.57,flashback,VANICA (FB),0,0,0,,Geliyorum!
Dialogue: 9,0:12:55.21,0:12:56.75,flashback,ACIER (FB),0,0,0,,Noelle! Nozel!
Dialogue: 9,0:12:56.75,0:13:00.50,flashback,VANICA (FB),0,0,0,,Bir sus artık be. Ayak bağı olma.
Dialogue: 9,0:13:00.77,0:13:03.42,flashback,VANICA (FB),0,0,0,,Belkide ilk seni öldürürümç
Dialogue: 9,0:13:03.84,0:13:06.42,flashback,VANICA (FB),0,0,0,,Bunlar senin çocukların mı Acier?
Dialogue: 9,0:13:06.42,0:13:08.80,flashback,VANICA (FB),0,0,0,,Niye çocuk yapasın ki?
Dialogue: 9,0:13:09.13,0:13:14.33,flashback,VANICA (FB),0,0,0,,Seni yorarlar, ayak bağı olurlar, senin gibi\Ngüçlü bir kadının bunlara ihtiyacı yok gibi görünüyor!
Dialogue: 9,0:13:16.52,0:13:19.69,flashback,ACIER (FB),0,0,0,,Sana dünyadaki en güçlü şeyi \Nsöylememe izin ver.
Dialogue: 9,0:13:20.40,0:13:23.66,flashback,ACIER (FB),0,0,0,,Çocuklarını korumaya çalışan bir anne...
Dialogue: 9,0:13:31.45,0:13:33.16,flashback italics,VANICA (FB)(INT),0,0,0,,Lanet Engelleyici Büyü...
Dialogue: 9,0:13:39.40,0:13:42.32,italics,VANICA (INT),0,0,0,,O esnada ölümcül yaralar aldım...
Dialogue: 9,0:13:42.81,0:13:45.30,italics,VANICA (INT),0,0,0,,Megicula bana kaçmamı söyledi, ikiletmedim.
Dialogue: 9,0:13:46.68,0:13:48.55,italics,VANICA (INT),0,0,0,,Şimdi hatırlıyorum.
Dialogue: 9,0:13:48.55,0:13:51.55,main,VANICA,0,0,0,,Daha çok! Daha çok istiyorum!
Dialogue: 9,0:13:51.55,0:13:54.80,italics,VANICA (INT),0,0,0,,Kan Büyüsü: Kızıl Canavar
Dialogue: 9,0:13:55.14,0:13:57.31,main,VANICA,0,0,0,,Kaldığımız yerden devam edelim!
Dialogue: 9,0:13:57.96,0:13:59.51,main,NOELLE,0,0,0,,Deniz Ejderi'nin Kükreyişi!
Dialogue: 9,0:14:07.76,0:14:10.28,main,NOELLE,0,0,0,,Ne istediysen onu yaptın, ama şimdi...
Dialogue: 9,0:14:11.41,0:14:12.93,main,NOELLE,0,0,0,,Bedelini ödeyeceksin!
Dialogue: 9,0:14:22.25,0:14:26.44,main,VANICA,0,0,0,,Sen en iyisisin Noelle!
Dialogue: 9,0:16:05.15,0:16:07.34,main,VANICA,0,0,0,,Noelle!
Dialogue: 9,0:16:12.22,0:16:15.49,main,VANICA,0,0,0,,Harika! Bu harika Noelle!
Dialogue: 9,0:16:15.78,0:16:18.13,main,VANICA,0,0,0,,Daha çok!
Dialogue: 9,0:16:26.88,0:16:31.55,main,VANICA,0,0,0,,Sen en iyisisin Noelle!
Dialogue: 9,0:16:59.94,0:17:02.42,main,NOELLE,0,0,0,,Kaybettin, Vanica!
Dialogue: 9,0:17:07.15,0:17:10.00,main,VANICA,0,0,0,,Harika... Hissettim!
Dialogue: 9,0:17:11.25,0:17:13.58,main,VANICA,0,0,0,,Bu his de ne?
Dialogue: 9,0:17:13.58,0:17:15.42,main,VANICA,0,0,0,,Yoksa bu...
Dialogue: 9,0:17:16.18,0:17:17.93,main,VANICA,0,0,0,,Arkadaşlık mı?!
Dialogue: 9,0:17:18.24,0:17:21.50,main,VANICA,0,0,0,,Şimdi sana yetişme sırası bende!
Dialogue: 9,0:17:21.50,0:17:23.69,main,VANICA,0,0,0,,Bu bizi rakip yapar değil mi?
Dialogue: 9,0:17:23.69,0:17:26.10,main,VANICA,0,0,0,,Bakalım kim daha güçlü olaca—
Dialogue: 9,0:17:26.10,0:17:27.40,main,NOELLE,0,0,0,,Hayatta olmaz.
Dialogue: 9,0:17:29.40,0:17:33.40,main,NOELLE,0,0,0,,Sırf tatmin oldun diye bunu burada\Nbitirecek değilim.
Dialogue: 9,0:17:35.18,0:17:37.85,main,NOELLE,0,0,0,,Burada öleceksin, Vanica!
Dialogue: 9,0:17:37.85,0:17:39.08,main,MEGICULA,0,0,0,,Biliyordum.
Dialogue: 9,0:17:39.74,0:17:43.50,main,MEGICULA,0,0,0,,Gerçekden eğlencelisin, Vanica.
Dialogue: 9,0:17:43.79,0:17:46.34,main,MEGICULA,0,0,0,,Bu hiç olmadı.
Dialogue: 9,0:17:50.03,0:17:51.46,italics,NOELLE (INT),0,0,0,,Bu büyü...
Dialogue: 9,0:17:52.40,0:17:55.35,main,MEGICULA,0,0,0,,Lucifero ve diğerleri \Nbizi fark etmedi.
Dialogue: 9,0:17:55.84,0:18:02.02,main,MEGICULA,0,0,0,,Aynı cinsiyetten en güçlü üç \Nbüyücünün ruhlarıda burada.
Dialogue: 9,0:18:03.26,0:18:07.06,main,MEGICULA,0,0,0,,Düşüşümün hazırlıkları tamamlandı.
Dialogue: 9,0:18:09.56,0:18:11.77,italics,CHARLOTTE (INT),0,0,0,,Lanetinin gücü...
Dialogue: 9,0:18:12.32,0:18:13.65,italics,CHARLOTTE (INT),0,0,0,,İmkansız!
Dialogue: 9,0:18:13.92,0:18:15.73,italics,CHARLOTTE (INT),0,0,0,,Hiç şüphe yok.
Dialogue: 9,0:18:15.73,0:18:16.65,italics,CHARLOTTE (INT),0,0,0,,O
Dialogue: 9,0:18:20.86,0:18:22.78,italics,CHARLOTTE (INT),0,0,0,,Kanlı Canlı Megicula'nın ta kendisi!
Dialogue: 9,0:18:24.75,0:18:28.92,main,MEGICULA,0,0,0,,Vanica ile çok uzun zaman geçirdim,\Nanlayabiliyorum.
Dialogue: 9,0:18:29.32,0:18:32.29,main,MEGICULA,0,0,0,,Eğer Vanica ve Loropechika ölürse,
Dialogue: 9,0:18:32.79,0:18:35.17,main,MEGICULA,0,0,0,,İdeallerim tamamlanacak.
Dialogue: 9,0:18:35.45,0:18:36.67,main,GAJA,0,0,0,,Kraliçe Loropechika!
Dialogue: 9,0:18:41.08,0:18:43.85,main,MEGICULA,0,0,0,,Bunlar olmadan önce, son bir kez\Ndövüşmene izin vereceğim.
Dialogue: 9,0:18:45.30,0:18:47.64,main,MEGICULA,0,0,0,,Beraber ölürseniz, o kadar da yalnız olmaz.
Dialogue: 9,0:18:48.19,0:18:51.17,main,MEGICULA,0,0,0,,Değil mi, insanlar?
Dialogue: 9,0:18:51.17,0:18:52.98,main,NOELLE,0,0,0,,Megicula.
Dialogue: 9,0:18:53.37,0:18:54.86,main,NOELLE,0,0,0,,Burada ne işin var?!
Dialogue: 9,0:18:54.86,0:18:58.17,main,NOELLE,0,0,0,,Sadece bir geçit açıldı!
Dialogue: 9,0:18:58.17,0:18:59.89,main,MEGICULA,0,0,0,,Geçitler sadece görüntüde.
Dialogue: 9,0:18:59.89,0:19:02.81,main,MEGICULA,0,0,0,,Benim amacım içinden geçmek.
Dialogue: 9,0:19:02.81,0:19:05.37,main,MEGICULA,0,0,0,,Lanet-Engelleyici Büyü: Kötücül Kadın
Dialogue: 9,0:19:05.69,0:19:09.32,main,MEGICULA,0,0,0,,Bu büyü ağır fedakarlıklar gerektiriyor
Dialogue: 9,0:19:09.32,0:19:11.62,main,MEGICULA,0,0,0,,Yani yapması baya zordu.
Dialogue: 9,0:19:12.17,0:19:15.43,main,MEGICULA,0,0,0,,Yonca Krallığı’ndan Soylu Acier Silva.
Dialogue: 9,0:19:15.43,0:19:20.63,main,MEGICULA,0,0,0,,Onu ölümüne lanetlemek kendimi \NVanicanın vücuduna yarı yarıya göndermemi sağladı.
Dialogue: 9,0:19:21.78,0:19:22.99,italics,NOELLE (INT),0,0,0,,Anne!
Dialogue: 9,0:19:23.79,0:19:25.77,main,MEGICULA,0,0,0,,Üstelik Benimle anlaşma yapan.
Dialogue: 9,0:19:25.77,0:19:28.27,main,MEGICULA,0,0,0,,Doğuştan yetenekli Şeytan Taşıyıcısı, Vanica.
Dialogue: 9,0:19:28.27,0:19:30.24,main,MEGICULA,0,0,0,,Onun ölmesiyle beraber.
Dialogue: 9,0:19:30.24,0:19:32.97,main,MEGICULA,0,0,0,,Böyle birleşebiliriz, tam tamamlanmamış\Nolsa bile.
Dialogue: 9,0:19:33.95,0:19:37.14,main,MEGICULA,0,0,0,,Son olarak, Kalp Krallığının Kraliçesi\NKraliçe Loropechika.
Dialogue: 9,0:19:37.14,0:19:43.52,main,MEGICULA,0,0,0,,O ve Vanica öldüğünde, tamamen \Nbu dünyaya geçeceğim.
Dialogue: 9,0:19:46.07,0:19:49.54,main,MEGICULA,0,0,0,,Şeytan Su Büyüsü: Darkneos'un Hidra'sı.
Dialogue: 9,0:19:49.86,0:19:52.04,main,NOELLE,0,0,0,,Bu büyü.
Dialogue: 9,0:19:52.04,0:19:53.71,main,NOELLE,0,0,0,,Loropechika'ya ne yaptın?!
Dialogue: 9,0:19:53.71,0:19:58.46,main,MEGICULA,0,0,0,,Lanetiyle biraz uğraşıp onu şeytana çevirdim.
Dialogue: 9,0:19:58.72,0:20:02.55,main,MEGICULA,0,0,0,,Ölmeden önce ona iyi\Nanlar yaşatırım diye düşünmüştüm.
Dialogue: 9,0:20:02.82,0:20:04.97,main,NOELLE,0,0,0,,Ne cürretle?!
Dialogue: 9,0:20:04.97,0:20:06.89,main,NOELLE,0,0,0,,Seni tam şu an ve burada yenece—
Dialogue: 9,0:20:11.66,0:20:13.06,italics,NOELLE (INT),0,0,0,,Büyüm yok oldu...
Dialogue: 9,0:20:13.06,0:20:16.07,main,MEGICULA,0,0,0,,Lanet Engelleyici Büyü: Çürüyen Dünya.
Dialogue: 9,0:20:16.39,0:20:18.49,main,MEGICULA,0,0,0,,Şu anki halim sayesinde, büyümün hızı
Dialogue: 9,0:20:18.49,0:20:21.79,main,MEGICULA,0,0,0,,ve gücü önceki ile kıyaslanamaz durumda.
Dialogue: 9,0:20:25.77,0:20:28.83,main,CHARLOTTE,0,0,0,,Daha fazla kafana göre hareket etmene\N izin vermeyeceğim!
Dialogue: 9,0:20:28.83,0:20:32.83,main,MEGICULA,0,0,0,,Lanetime karşı koyabilen ilk kişisin.
Dialogue: 9,0:20:33.25,0:20:36.44,main,MEGICULA,0,0,0,,Gayet başarılıydın, Sarmaşıklar Kraliçesi.
Dialogue: 9,0:20:37.80,0:20:40.46,italics,RILL (INT),0,0,0,,Ne olursa olsun Charlotte'u\Nkorumam lazım.
Dialogue: 9,0:20:40.46,0:20:43.88,main,MEGICULA,0,0,0,,Lanet Engelleyici Büyü: Bağımsız Köle.
Dialogue: 9,0:20:44.57,0:20:49.14,italics,RILL (INT),0,0,0,,Noelle'in müthiş büyüsü\Nbana ilham verdi!
Dialogue: 9,0:20:50.41,0:20:51.43,italics,RILL (INT),0,0,0,,Görsel Büyüsü...
Dialogue: 9,0:20:53.36,0:20:54.98,italics,RILL (INT),0,0,0,,Alacakaranlık Valhalla!
Dialogue: 9,0:21:04.71,0:21:08.11,italics,GAJA (INT),0,0,0,,Mutlak Yıldırım Büyüsü: Nadaras do Astrauza!
Dialogue: 9,0:21:16.76,0:21:19.71,flashback,LOROPECHIKA (FB),0,0,0,,Hiç saldırı büyüsü  kullanamıyorum.
Dialogue: 9,0:21:19.96,0:21:22.14,flashback,LOROPECHIKA (FB),0,0,0,,Sanırım kraliçe olmaya uygun değilim.
Dialogue: 9,0:21:26.51,0:21:27.43,italics,GAJA (INT),0,0,0,,Ben...
Dialogue: 9,0:21:28.26,0:21:32.14,italics,GAJA (INT),0,0,0,,Kalp Krallığı'nın en güçlü Saldırı büyücüsü \Nolmaya karar verdim.
Dialogue: 9,0:21:32.97,0:21:34.98,italics,GAJA (INT),0,0,0,,tüm düşmanlarımızı yenmek için...
Dialogue: 9,0:21:36.62,0:21:40.47,italics,GAJA (INT),0,0,0,,senin yerine,
Dialogue: 9,0:21:45.37,0:21:47.41,main,GAJA,0,0,0,,Senin...
Dialogue: 9,0:21:59.93,0:22:00.63,main,NOELLE,0,0,0,,Millet!
Dialogue: 9,0:22:08.63,0:22:11.39,italics,NOELLE (INT),0,0,0,,Ruh Dalışım... Tamamlanamadı.
Dialogue: 9,0:22:13.11,0:22:14.48,main,MEGICULA,0,0,0,,Sizin...
Dialogue: 9,0:22:17.85,0:22:19.02,main,MEGICULA,0,0,0,,Kayıbınız.
Dialogue: 9,0:22:19.02,0:22:22.02,main,,0,0,0,,
